{
  "manifest_version": 3,
  "name": "JSeek Enhancer",
  "version": "1.2.0",
  "description": "Automates resume tailoring, cold messages, H1-B filtering, and recruiter search across 12 job platforms.",
  "permissions": ["activeTab", "downloads", "storage", "clipboardWrite"],
  "host_permissions": [
    "*://*/*",
    "http://localhost:4567/*",
    "https://jseek.co/*",
    "https://*.linkedin.com/*",
    "https://*.jobright.ai/*",
    "https://*.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://www.ziprecruiter.com/*",
    "https://builtin.com/*",
    "https://*.builtin.com/*",
    "https://builtinnyc.com/*",
    "https://builtinboston.com/*",
    "https://builtinchicago.com/*",
    "https://builtincolorado.com/*",
    "https://builtinla.com/*",
    "https://builtinaustin.com/*",
    "https://builtinsf.com/*",
    "https://builtinseattle.com/*",
    "https://wellfound.com/*",
    "https://www.dice.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "https://jseek.co/*",
        "https://*.linkedin.com/*",
        "https://*.jobright.ai/*",
        "https://*.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://www.ziprecruiter.com/*",
        "https://builtin.com/*",
        "https://*.builtin.com/*",
        "https://builtinnyc.com/*",
        "https://builtinboston.com/*",
        "https://builtinchicago.com/*",
        "https://builtincolorado.com/*",
        "https://builtinla.com/*",
        "https://builtinaustin.com/*",
        "https://builtinsf.com/*",
        "https://builtinseattle.com/*",
        "https://wellfound.com/*",
        "https://www.dice.com/*"
      ],
      "js": ["site_configs.js", "content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["h1b_data.json"],
      "matches": ["https://jseek.co/*"]
    }
  ]
}
