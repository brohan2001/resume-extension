{
  "name": "jseek-enhancer-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --ignore resumes/ --exec 'node --env-file=.env' server.js",
    "test": "vitest run",
    "test:live": "vitest run tests/live.test.js",
    "test:ui": "vitest run tests/ui.test.js",
    "benchmark": "node --env-file=.env scripts/benchmark-models.js",
    "build:firefox": "rm -rf dist/firefox && mkdir -p dist/firefox && cp manifest_firefox.json dist/firefox/manifest.json && cp background.js content_script.js site_configs.js h1b_data.json options.html options.js dist/firefox/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
